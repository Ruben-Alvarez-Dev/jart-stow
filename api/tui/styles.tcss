/* Jart-Stow TUI Theme */

Screen {
    background: $surface;
}

/* --- Main menu cards --- */

.menu-card {
    width: 100%;
    height: auto;
    padding: 1 2;
    margin: 0 1;
    border: round $primary;
    background: $surface;
}

.menu-card.highlighted {
    border: round $accent;
    background: $primary 15%;
    text-style: bold;
}

.menu-card:hover {
    border: round $accent;
    background: $primary 10%;
}

.menu-title {
    color: $text;
    text-style: bold;
}

.menu-desc {
    color: $text-muted;
}

/* --- Status cards --- */

.card {
    width: 100%;
    height: auto;
    padding: 1 2;
    border: round $primary;
    background: $surface;
}

.card-title {
    color: $primary;
    text-style: bold;
    margin-bottom: 1;
}

/* --- Navigation bar --- */

.nav-bar {
    dock: bottom;
    height: 1;
    background: $primary 20%;
    color: $text-muted;
    padding: 0 1;
}

/* --- Filter / sort bars --- */

.filter-bar {
    height: 3;
    margin-bottom: 1;
}

.filter-toggle {
    margin: 0 1;
}

.filter-toggle.active {
    text-style: bold;
    background: $primary 30%;
}

/* --- Data tables --- */

DataTable {
    height: 1fr;
}

DataTable > .datatable--cursor {
    background: $primary 30%;
}

/* --- Split panels --- */

.split-left {
    width: 1fr;
    height: 1fr;
    border-right: solid $primary;
}

.split-right {
    width: 2fr;
    height: 1fr;
}

/* --- Status indicators --- */

.status-running {
    color: $success;
}

.status-stopped {
    color: $error;
}

.status-ok {
    color: $success;
}

.status-warning {
    color: $warning;
}

.status-archived {
    color: $text-muted;
}

/* --- Detail panel --- */

.detail-panel {
    height: auto;
    max-height: 8;
    padding: 1 2;
    border-top: solid $primary;
    background: $surface;
}

/* --- Breakdown bars --- */

.bar-label {
    width: 20;
}

.bar-track {
    width: 1fr;
    height: 1;
    background: $primary 20%;
}

.bar-fill {
    height: 1;
    background: $primary;
}
